{
  "name": "rav",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch:ads": "tsx data_sources/snap_ads/src/fetch_ads.ts ads",
    "fetch:sponsored": "tsx data_sources/snap_sponsored/src/fetch_sponsored.ts sponsored",
    "fetch:ad": "tsx data_sources/snap_ads/src/fetch_ads.ts ad",
    "fetch:political": "tsx data_sources/snap_political/src/fetch_political.ts",
    "fetch:political:summary": "tsx data_sources/snap_political/src/fetch_political.ts --summary",
    "stats:sponsored": "tsx data_sources/snap_sponsored/src/run_stats.ts",
    "fetch:profiles": "tsx data_sources/snap_profiles/src/fetch_profiles.ts",
    "fetch:explore": "tsx data_sources/snap_explore/src/fetch_explore.ts",
    "fetch:spotlights": "tsx data_sources/snap_spotlights/src/fetch_spotlights.ts",
    "fetch:sor": "tsx data_sources/dsa_transparency/src/fetch_sor.ts",
    "app:data": "tsx app/build_dataset.ts",
    "app:dev": "cd app && npm run dev",
    "app:api": "tsx app/server.ts",
    "app:build": "cd app && npm run build",
    "app:start": "npm run build && node --import tsx/esm app/server.ts",
    "build": "cd app && npm install && npm run build && cd ../app-political && npm install && npm run build",
    "start": "node --import tsx/esm app/server.ts",
    "db:init": "duckdb db/rav.db < db/init.sql",
    "pol:data": "tsx app-political/build_report.ts",
    "pol:dev": "cd app-political && npm run dev",
    "pol:build": "cd app-political && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "got-scraping": "^4.2.1",
    "tsx": "^4.19.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2"
  }
}
